# 请勿把真实 Key 提交到代码或发送到聊天中。
# 本文件仅作为变量清单；Node.js 18 不会自动读取 .env。
# Windows PowerShell 临时配置示例：
# $env:DASHSCOPE_API_KEY="你的Key"

DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 设置为 1 可强制使用稳定的演示兜底结果
LOCALOPS_DEMO_MODE=0
# 可选：修改本地服务端口
LOCALOPS_PORT=4173
